# ─── Supabase ──────────────────────────────────
# The worker and ingest services read these.
SUPABASE_URL=https://your-supabase.yourdomain.com
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# The SvelteKit frontend reads its own PUBLIC_-prefixed pair, plus a private
# service key. Same values as above; separate names because Vite only exposes
# PUBLIC_* to the browser.
PUBLIC_SUPABASE_URL=https://your-supabase.yourdomain.com
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PRIVATE_SUPABASE_SERVICE_KEY=your-service-role-key

# ─── Redis ─────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Ingest Service URL ───────────────────────
PUBLIC_INGEST_URL=https://ingest.apidown.net
# Server-side alias, used where PUBLIC_INGEST_URL is not in scope.
INGEST_URL=https://ingest.apidown.net

# ─── Service ports and logging ────────────────
# All optional; sensible defaults apply when unset.
PORT=3001
HOST=0.0.0.0
HEALTH_PORT=3002
LOG_LEVEL=info

# ─── SMTP (Email Alerts) ──────────────────────
ALERT_FROM_EMAIL=alerts@apidown.net
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
# Optional envelope sender; falls back to ALERT_FROM_EMAIL.
SMTP_FROM=alerts@apidown.net

# ─── Web Push (browser notifications, US-156) ──
# Generate a key pair with: npx web-push generate-vapid-keys
# Without these, browser notifications are cleanly disabled and the UI says so.
PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:alerts@apidown.net

# ─── Reporter IP pseudonymisation (US-178) ─────
# Keys the HMAC that turns a reporter's IP into the rate-limit identifier
# stored in manual_reports.reporter_ip. REQUIRED in production: without it each
# process generates a random salt, so rate limits stop holding across restarts
# and between instances. Must be at least 16 characters.
# Generate one with: openssl rand -hex 32
# Changing it resets the one-hour report rate-limit window, and nothing else.
IP_HASH_SALT=

# ─── Weekly digest (US-166) ────────────────────
PUBLIC_SITE_URL=https://apidown.net
# Optional pacing between digest sends, in ms (default 250)
DIGEST_BATCH_DELAY_MS=250

# ─── Stripe billing ────────────────────────────
# Products are created in the Stripe dashboard; paste their price IDs here.
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRO_PRICE_ID=price_pro_monthly
STRIPE_TEAM_PRICE_ID=price_team_monthly

# ─── Synthetic probe auth encryption ───────────
# AES-256-GCM key protecting custom-API auth headers at rest. Exactly 64 hex
# characters (32 bytes). Required by the worker and ingest whenever a custom
# API has an auth header; probe-crypto.js throws without it.
# Generate one with: openssl rand -hex 32
# Losing or changing it makes existing stored auth headers undecryptable.
PROBE_ENCRYPTION_KEY=

# ─── Google Search Console indexing (optional) ─
# Service account JSON, as a single-line string. Unset disables index pinging.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── apidown CLI (packages/cli) ────────────────
# Only needed to point the CLI at a non-production API.
APIDOWN_API_BASE=https://apidown.net
